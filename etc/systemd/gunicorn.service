[Unit]
Description=Gunicorn instance to serve myproject
After=network.target

[Service]
User=www-data
Group=www-data

WorkingDirectory=/home/vagrant/app/django-community-board
Environment="PATH=/home/vagrant/.venv/bin"
ExecStart=/home/vagrant/.venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 wsgi:django-community-board

Restart=always

[Install]
WantedBy=multi-user.target