//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

//도메인->ip 설정추가
zone "projectys.co.kr" {
	type master;
	file "/etc/bind/zones/db.projectys.co.kr";
};
//ip->도메인, ip 주소로 도메인 이름을 찾아내기 위해 설정
zone "11.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.11.rev";
};
