[Unit]
Description=Gunicorn instance to serve myproject
After=network.target

[Service]
User=vagrant
Group=www-data

WorkingDirectory=/home/vagrant/app/django-community-board
Environment="PATH=/home/vagrant/.venv/bin"
ExecStart=/home/vagrant/.venv/bin/gunicorn --workers 3 \
  --access-logfile /var/log/gunicorn-accesslog.log \
  --error-logfile /var/log/gunicorn-errorlog.log \
  --bind 0.0.0.0:8000 community_board_project.wsgi:application

Restart=always

[Install]
WantedBy=multi-user.target

