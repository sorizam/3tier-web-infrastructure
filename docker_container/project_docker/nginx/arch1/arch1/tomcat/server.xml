<Server port="8005" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <Service name="Catalina">

    <!-- HTTP/1.1 Connector on port 8080 -->
    <Connector port="8080" protocol="HTTP/1.1"
               connectionTimeout="20000"
               redirectPort="8443"
               maxThreads="200"
               minSpareThreads="10"
               maxConnections="8192"
               acceptCount="100"
               enableLookups="false"
               compression="on"
               compressionMinSize="2048"
               compressibleMimeType="text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json"
               URIEncoding="UTF-8"
               useBodyEncodingForURI="true"
               server="Arch1-Tomcat"
               />

    <!-- AJP/1.3 Connector on port 8009 -->
    <Connector port="8009" protocol="AJP/1.3"
               redirectPort="8443"
               maxThreads="200"
               minSpareThreads="10"
               enableLookups="false"
               />

    <!-- Engine name="Catalina" defaultHost="localhost" -->
    <Engine name="Catalina" defaultHost="localhost">

      <!-- Host name="localhost"  appBase="webapps" unpackWARs="true" autoDeploy="true" -->
      <Host name="localhost" appBase="webapps"
            unpackWARs="true" autoDeploy="true">

        <!-- SingleSignOn valve, share authentication between web applications
             Documentation at: /docs/config/valve.html -->
        <Valve className="org.apache.catalina.authenticator.SingleSignOn" />

        <!-- Access log processes all example.
             Documentation at: /docs/config/valve.html
             Note: The pattern used is equivalent to using pattern="common" -->
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="localhost_access_log" suffix=".txt"
               pattern="%h %l %u %t &quot;%r&quot; %s %b" />

        <!-- Context for Arch1 application -->
        <Context path="/arch1-webapp" 
                 docBase="arch1-webapp-0.0.1-SNAPSHOT-plain.war"
                 reloadable="false"
                 antiResourceLocking="true"
                 antiJARLocking="true">
          
          <!-- Database connection pool -->
          <Resource name="jdbc/arch1db" 
                    auth="Container" 
                    type="javax.sql.DataSource"
                    maxTotal="20" 
                    maxIdle="10"
                    maxWaitMillis="-1"
                    username="admin" 
                    password="1qaz@WSX"
                    driverClassName="com.mysql.cj.jdbc.Driver"
                    url="jdbc:mysql://192.168.11.100:3306/arch1db?useSSL=false&amp;serverTimezone=Asia/Seoul&amp;characterEncoding=UTF-8&amp;allowPublicKeyRetrieval=true"
                    validationQuery="SELECT 1"
                    testOnBorrow="true"
                    testOnReturn="false"
                    testWhileIdle="true"
                    timeBetweenEvictionRunsMillis="60000"
                    minEvictableIdleTimeMillis="30000"
                    />
          
          <!-- JNDI configuration -->
          <Environment name="app/database/url" 
                       value="jdbc:mysql://192.168.11.100:3306/arch1db" 
                       type="java.lang.String" override="false"/>
          <Environment name="app/database/username" 
                       value="admin" 
                       type="java.lang.String" override="false"/>
          <Environment name="app/database/password" 
                       value="1qaz@WSX" 
                       type="java.lang.String" override="false"/>
        </Context>

      </Host>
    </Engine>
  </Service>
</Server>
