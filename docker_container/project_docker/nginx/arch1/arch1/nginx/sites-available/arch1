# Arch1 Web Application Nginx Configuration
# This file should be placed in /etc/nginx/sites-available/
# and linked to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name arch1.local www.arch1.local;
    
    # Document root for static files
    root /var/www/arch1/frontend;
    index index.html index.htm;
    
    # Logs
    access_log /var/log/nginx/arch1_access.log;
    error_log /var/log/nginx/arch1_error.log;
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    
    # Static files (frontend)
    location / {
        try_files $uri $uri/ @tomcat_proxy;
    }
    
    # Proxy to Tomcat for backend API
    location /backend/ {
        # Rate limiting
        limit_req zone=api burst=20 nodelay;
        
        # Remove /backend prefix when forwarding to Tomcat
        rewrite ^/backend/(.*)$ /$1 break;
        
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # Timeout settings
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Error handling
        proxy_intercept_errors on;
        error_page 502 503 504 /50x.html;
    }
    
    # Health check endpoint
    location /health {
        access_log off;
        return 200 "Arch1 is healthy\n";
        add_header Content-Type text/plain;
    }
    
    # Deny access to sensitive files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    location ~ /\.(htaccess|htpasswd)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Deny access to backup files
    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}
